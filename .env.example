# Copy this file to .env and fill in your own values. Never commit or submit .env.

# Which engine answers the chat: ollama = local LLaMA 3 (the project requirement), groq = Groq API
AI_MODE=ollama

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/

# Google OAuth 2.0 (redirect URI: http://localhost:5000/login/google/callback)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Keeps users signed in across server restarts; any long random string
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# 1 = auto-reload and debugger while developing; leave 0 for demos
FLASK_DEBUG=0

# Local LLaMA 3 through Ollama (AI_MODE=ollama)
# If Windows reserves port 11434, run Ollama with OLLAMA_HOST=127.0.0.1:11600 and use that port here.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_MAX_TOKENS=256
OLLAMA_HISTORY_MESSAGES=6
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=300

# Groq API (only for AI_MODE=groq)
GROQ_API_KEY=your-groq-api-key
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_MAX_TOKENS=1024
GROQ_HISTORY_MESSAGES=6
